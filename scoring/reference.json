        "median_elbow_wrist_cm": {"higher_is_better": false, "coefficient": -1.0},
        "mean_elbow_wrist_cm": {"higher_is_better": false, "coefficient": -0.4},
        "param_count_k": {"higher_is_better": false, "coefficient": -0.2}
      },
      "results": {
        "imu_only": {
          "type": "baseline",
          "median_elbow_cm": 11.7,
          "median_wrist_cm": 16.7,
